# Copy to .env (git-ignored) and fill in. Every value below is optional except OPENAI_API_KEY
# (unless you run the offline demo: REPORTLENS_DEMO_MOCK=1).

# --- OpenAI ------------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # only for proxies / Azure-compatible gateways / the offline mock

# --- PageIndex (local "Flash" mode: needs only the OpenAI key) ----------------------------
# Model names follow the PageIndex docs: index=gpt-5.6-luna (summaries, cheap), chat=gpt-5.6-sol (retrieval + answer).
PI_INDEX_MODEL=gpt-5.6-luna
PI_CHAT_MODEL=gpt-5.6-sol
PI_CHAT_REASONING_EFFORT=medium       # none|low|medium|high|xhigh|max  (empty = model default; leave empty for non-reasoning models)
PI_CHAT_PROTOCOL=responses            # responses (recommended for gpt-5.6/gpt-6 + tools) | chat (LiteLLM chat-completions lane)
PI_CHAT_MAX_TURNS=12                  # agent loop cap per question
PI_INDEX_SUMMARY_CONCURRENCY=16       # lower (8) if you hit 429s on a small OpenAI tier
PI_INDEX_FALLBACK_STANDARD=true       # PDFs without bookmarks (>10 pages): fall back to the slower LLM-built tree instead of failing

QUESTION_REWRITE_MODEL=gpt-4.1-mini     # rewrites follow-up questions into standalone ones (RAGAS user_input); falls back to the raw question

# --- RAGAS evaluation ---------------------------------------------------------------------
EVAL_ENABLED=true
RAGAS_JUDGE_MODEL=gpt-4.1             # non-reasoning judge (ragas 0.4.3 mis-handles gpt-5.x/6.x names). gpt-4.1-mini loops on long faithfulness prompts - do not use
RAGAS_JUDGE_REASONING_EFFORT=
RAGAS_JUDGE_MAX_TOKENS=4096
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
EVAL_MAX_CONTEXTS=12                  # pages passed as retrieved_contexts (context precision = 1 judge call per page)
EVAL_MAX_CHARS_PER_CONTEXT=8000

# --- App ----------------------------------------------------------------------------------
REPORTLENS_HOST=127.0.0.1
REPORTLENS_PORT=8000
REPORTLENS_DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_PAGES=1200
HISTORY_TURNS=6                       # previous Q/A pairs sent to the agent for follow-up questions

# --- Offline demo -------------------------------------------------------------------------
# 1 = start an in-process fake OpenAI server (devtools/mock_openai.py) and point everything at it.
# Lets you click through the whole UI (upload, chat, citations, highlights, scores) with NO API key and NO cost.
# Answers are canned extracts from your PDF, not real model output; scores are meaningless.
REPORTLENS_DEMO_MOCK=0

# --- Public deployment (Hugging Face Spaces / Render; see docs/DEPLOY.md) ---------------------------------
# Everything below is OFF by default: the app stays a single-user localhost tool. On a host, set these as
# Secrets / Variables in its settings page, not in a file you push.
# PUBLIC_MODE=1                       # safe defaults for whatever is not set below: BUDGET_USD_TOTAL=10, MAX_SESSIONS=30,
#                                     # QUESTIONS_PER_HOUR_PER_IP=15, MAX_UPLOAD_MB=25, MAX_PAGES=400,
#                                     # PI_INDEX_FALLBACK_STANDARD=false, EVAL_MAX_CONTEXTS=8
# ACCESS_CODE=                        # set = visitors must enter it before they can use the API (use 12+ random characters)
# SESSION_SECRET=                     # optional: keeps logins valid across restarts (default: a random secret per process)
# BUDGET_USD_TOTAL=0                  # estimated OpenAI spend (USD) after which uploads and questions are refused; 0 = unlimited
# MAX_SESSIONS=0                      # chats that may exist at once; 0 = unlimited
# QUESTIONS_PER_HOUR_PER_IP=0         # per visitor address; 0 = unlimited
# INDEX_COST_ESTIMATE_USD=0.40        # what one indexed document is charged to the budget
# EVAL_COST_ESTIMATE_USD=0.08         # what one completed RAGAS scoring is charged to the budget
# ALLOWED_HOSTS=.onrender.com         # comma list of accepted Host names; a leading dot also matches every subdomain
# TRUST_PROXY=1                       # only behind a proxy you trust (HF, Render): believe X-Forwarded-For/-Host for IP limits
# PROXY_HOPS=0                        # 0 = visitor is the first X-Forwarded-For entry; N = the Nth from the right
# PORT=                               # injected by Render; Hugging Face uses 7860 (REPORTLENS_PORT wins over PORT)
# LOW_MEMORY=1                       # small host (Render free: 512 MB, 0.1 CPU): index in a child process, load scoring libraries lazily,
#                                     # one open PDF, lower concurrency. Automatic with PUBLIC_MODE in a container limited to <= 600 MB; 0 turns it off
# INDEX_IN_SUBPROCESS=                # default = LOW_MEMORY; 1/0 forces the child-process indexing on or off
